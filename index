import os
import json
import urllib.request
from http.server import BaseHTTPRequestHandler

BOT_TOKEN = os.environ.get("BOT_TOKEN")


def telegram(method, data):
    url = "https://api.telegram.org/bot" + BOT_TOKEN + "/" + method

    request = urllib.request.Request(
        url,
        data=json.dumps(data).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    with urllib.request.urlopen(request, timeout=10) as response:
        return json.loads(response.read().decode("utf-8"))


def send_message(chat_id, text, keyboard=None):
    data = {
        "chat_id": chat_id,
        "text": text
    }

    if keyboard:
        data["reply_markup"] = {
            "inline_keyboard": keyboard
        }

    telegram("sendMessage", data)


def start_handler(message):
    chat_id = message["chat"]["id"]

    text = (
        "🎉 Welcome to EarnXpress!\n\n"
        "💰 কাজ করুন, Points সংগ্রহ করুন এবং Reward নিন।\n\n"
        "নিচের Menu থেকে আপনার পছন্দের অপশন নির্বাচন করুন। 👇"
    )

    keyboard = [
        [
            {"text": "🏠 হোম", "callback_data": "home"},
            {"text": "💰 Earn Now", "callback_data": "earn"}
        ],
        [
            {"text": "🎁 Daily Bonus", "callback_data": "daily"},
            {"text": "👥 Referral", "callback_data": "referral"}
        ],
        [
            {"text": "💳 My Wallet", "callback_data": "wallet"},
            {"text": "💸 Withdraw", "callback_data": "withdraw"}
        ],
        [
            {"text": "🏆 Leaderboard", "callback_data": "leaderboard"},
            {"text": "👤 My Profile", "callback_data": "profile"}
        ],
        [
            {"text": "❓ Help", "callback_data": "help"}
        ]
    ]

    send_message(chat_id, text, keyboard)


COMMAND_HANDLERS = {
    "start": start_handler
}

CALLBACK_HANDLERS = {}


class handler(BaseHTTPRequestHandler):

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length)
            update = json.loads(body.decode("utf-8"))

            if "message" in update:
                message = update["message"]
                text = message.get("text", "")

                if text.startswith("/"):
                    command = text.split()[0].replace("/", "").split("@")[0]

                    if command in COMMAND_HANDLERS:
                        COMMAND_HANDLERS[command](message)

            elif "callback_query" in update:
                callback = update["callback_query"]
                data = callback.get("data")
                chat_id = callback["message"]["chat"]["id"]

                if data in CALLBACK_HANDLERS:
                    CALLBACK_HANDLERS[data](callback)
                else:
                    send_message(
                        chat_id,
                        "⏳ এই অপশনটি এখনো চালু করা হয়নি।"
                    )

            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"OK")

        except Exception:
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"OK")
